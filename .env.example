# Copy to .env (git-ignored) or export these in your shell. All values are optional;
# the defaults below match the local Docker Compose stack. See docs/CONFIGURATION.md.

# --- Web app -------------------------------------------------------------
WEB_PORT=4000
# Remote access: listen beyond localhost only with an API key (see docs/CONFIGURATION.md#remote-access)
WEB_HOST=127.0.0.1
PERF_API_KEY=
PERF_ALLOWED_HOSTS=
# Shared drive and remote load generators (see docs/LOAD-GENERATORS.md)
PERF_SHARED_DIR=
PERF_AGENT_TOKEN=
PERF_AGENT_INFLUXDB_URL=
POSTGRES_PASSWORD=local-dev-only
# DATABASE_URL=postgres://perf_framework:local-dev-only@localhost:5433/perf_framework
GRAFANA_BASE_URL=http://localhost:3000
# URL JMeter (inside Docker) uses to write metrics
INFLUXDB_URL=http://influxdb:8086/write?db=jmeter
JMETER_IMAGE=perf-framework-jmeter:5.6.3
JMETER_DOCKER_NETWORK=infra_jmeter-network
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Run-finished notifications (leave the URL empty to disable)
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_FORMAT=slack
APP_BASE_URL=http://localhost:4000
# Regression checks with perf-insight (leave the URL empty to disable; see docs/PERF-INSIGHT.md)
PERF_INSIGHT_URL=
PERF_INSIGHT_API_KEY=
PERF_INSIGHT_ENVIRONMENT=
PERF_INSIGHT_SKIP_AI=false
PERF_INSIGHT_TIMEOUT_SECONDS=300

# --- Docker Compose ------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin

# --- MCP server ----------------------------------------------------------
PERF_WEB_URL=http://localhost:4000
INFLUXDB_QUERY_URL=http://localhost:8086/query
INFLUXDB_DATABASE=jmeter
MCP_READ_ONLY=false
MCP_MAX_USERS=200
MCP_MAX_DURATION_SECONDS=3600
MCP_REQUEST_TIMEOUT_MS=30000
